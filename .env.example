# =============================================================================
# AGROCHAIN - Variables de Entorno
# Copiar este archivo a .env y completar los valores
# =============================================================================

# ── BASE DE DATOS (PostgreSQL) ───────────────────────────────────────────────
# Local (docker compose up postgres): usar estos valores por defecto.
# En docker-compose.yml, DB_HOST pasa a ser "postgres" (nombre del servicio).
DB_HOST=localhost
DB_PORT=5434
DB_USER=agrochain_user
DB_PASSWORD=agrochain_pass
DB_NAME=agrochain_db
DATABASE_URL=postgresql://agrochain_user:agrochain_pass@localhost:5434/agrochain_db

# En RDS (produccion): DATABASE_URL apunta al endpoint de RDS y activa TLS
# automaticamente (ver packages/database/src/db/client.ts — detecta el host
# por regex; cualquier host que no sea localhost/postgres/127.0.0.1 usa SSL).

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=cambiar-por-secreto-seguro-minimo-32-chars
CORS_ORIGIN=http://localhost:3000

# ── AUTENTICACION HIBRIDA (AWS Cognito) ──────────────────────────────────────
# Si se dejan vacias, la API usa el fallback local (bcrypt contra
# usuarios.password_hash) — ver apps/api/src/routes/auth.ts. Para activar
# Cognito en produccion, crear el User Pool y llenar estas dos variables;
# no requiere ningun otro cambio de codigo.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── AWS (S3 evidencia + Cognito) ─────────────────────────────────────────────
# En EC2/produccion se usa el IAM Role de la instancia (sin credenciales en
# .env); en desarrollo local se llenan aqui. Usuario recomendado: crear un
# IAM user dedicado con permisos acotados solo al bucket de este proyecto
# (ver README — mismo patron que agrochain-local-dev).
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── S3 (evidencia — fotos/audio de campanas, documentos, evidencia EUDR) ────
S3_BUCKET=agrochain-evidencia-dev

# ── POLYGON BLOCKCHAIN ────────────────────────────────────────────────────────
# Amoy testnet. El RPC oficial (rpc-amoy.polygon.technology) puede no resolver
# DNS en algunos entornos (sandboxes, ciertas redes corporativas) — drpc.org
# es una alternativa confiable en la misma red.
POLYGON_RPC_URL=https://polygon-amoy.drpc.org
POLYGON_CHAIN_ID=80002

# Wallet del backend (firma transacciones — NO exponer en cliente)
BACKEND_WALLET_PRIVATE_KEY=

# Direcciones de contratos ya desplegados en Amoy — ver
# packages/contracts/deployments/amoy.json (desplegados 2026-03-09).
# Para re-desplegar: pnpm --filter @agrochain/contracts deploy:amoy
CONTRACT_LOTE_REGISTRY=0x6f4C1D2c02f39bB8B50E848CdA743F8300bcc5dc
CONTRACT_CERTIFICADO_NFT=0x338b8413CaB60D31E4CE7f272f7eFfE73280A538
CONTRACT_ROLE_MANAGER=0x84565cf3d3A9Ed7589d4D972B45247C17f586bd0

# ── FRONTEND (apps/web) ──────────────────────────────────────────────────────
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
