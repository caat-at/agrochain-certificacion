{
  "name": "@agrochain/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "node ../../node_modules/typescript/bin/tsc --watch",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx src/seed/index.ts"
  },
  "dependencies": {
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
